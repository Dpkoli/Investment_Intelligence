# ── Contrarian Radar ETL — environment variables ──────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Required: Supabase service-role key (bypasses RLS for ETL writes).
# Obtain from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Override log verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
